[sub_resource type="GDScript" id=31]
script/source = "extends PanelContainer

onready var NetworkBridge = Global.get_node(\"Multiplayer/NetworkBridge\")
onready var main_tab = get_parent()

onready var Multiplayer = Global.get_node(\"Multiplayer\")

onready var SteamLobby = Global.get_node(\"Multiplayer/SteamInit/SteamLobby\")

func _ready():
	main_tab.current_tab = 0

func lan_selected():
	NetworkBridge.set_mode(NetworkBridge.MULTIPLAYER_TYPE.LAN)
	main_tab.current_tab = 1
	get_parent().get_parent().current_tab = 0

func steam_selected():
	if Multiplayer.SteamInit.is_online:
		$\"../Steam/VBoxContainer/PlayersList/LobbyList\".show()
		NetworkBridge.set_mode(NetworkBridge.MULTIPLAYER_TYPE.STEAM)
		$\"../Steam\".get_lobbies()
		main_tab.current_tab = 2
		get_parent().get_parent().current_tab = 0
"

[sub_resource type="GDScript" id=18]
script/source = "extends Label

func _ready():
	text = get_tree().get_nodes_in_group(\"Multiplayer\")[0].version
"

[sub_resource type="GDScript" id=12]
script/source = "extends PanelContainer

onready var main_tab = get_parent()

onready var playersList = $VBoxContainer/PlayersList/PlayersListLabel
onready var status = $VBoxContainer/Status/StatusLabel

onready var Multiplayer = Global.get_node(\"Multiplayer\")

func _ready():
	playersList.bbcode_text = \"\"
	
	Multiplayer.connect(\"status_update\", self, \"update_status\")
	Multiplayer.connect(\"players_update\", self, \"update_players_info\")

func update_status(new_status):
	status.text = new_status

func update_players_info(info):
	var playerNumber = 1
	playersList.bbcode_text = \"\"
	
	for player in info:
		print(info[player])
		playersList.bbcode_text += str(playerNumber) + \": [color=#\" + info[player].color + \"]\" + info[player].nickname + \"[/color]\"
		
		if player == 1:
			playersList.bbcode_text += \" (host)\\n\"
		else:
			playersList.bbcode_text += \"\\n\"
		
		playerNumber += 1

func back_to_menu():
	main_tab.current_tab = 0
	Multiplayer.leave_server()
"

