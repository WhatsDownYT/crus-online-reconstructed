[sub_resource type="GDScript" id=16]
script/source = "extends HBoxContainer

func r_change(text):
	if int(text) > 255: text = \"255\"
	if int(text) < 0: text = \"0\"
	
	$Red.text = str(int(text))
	$ColorRect.color.r8 = int(int(text))

func g_change(text):
	if int(text) > 255: text = \"255\"
	if int(text) < 0: text = \"0\"
	
	$Green.text = str(int(text))
	$ColorRect.color.g8 = int(int(text))

func b_change(text):
	if int(text) > 255: text = \"255\"
	if int(text) < 0: text = \"0\"
	
	$Blue.text = str(int(text))
	$ColorRect.color.b8 = int(int(text))

func focus_exited():
	r_change($Red.text)
	g_change($Green.text)
	b_change($Blue.text)
"

[sub_resource type="GDScript" id=2]
script/source = "extends HBoxContainer

export (Array,Array) var playerSkins

var selected = 0

func _ready():
	for skin in playerSkins:
		$ItemList.add_item(skin[0])

func _skin_selected(index):
	$TextureRect.texture = playerSkins[index][2]
	selected = index

func set_texture(path):
	selected = 0
	for index in range(playerSkins.size()):
		if playerSkins[index][1] == path:
			selected = index
			break
	if not playerSkins.empty():
		$ItemList.select(selected)
		$TextureRect.texture = playerSkins[selected][2]

func get_texture():
	return playerSkins[selected][1]
"

